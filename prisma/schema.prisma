generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url  	   = env("DATABASE_URL")
}

model Layanan {
  id_layanan   Int      @id @default(autoincrement())
  nama_layanan String   @db.VarChar(100)

  clients      Client[]
}

model Client {
  id_client       Int      @id @default(autoincrement())
  nama_client     String   @db.VarChar(100)
  website_client  String   @db.VarChar(255)
  id_layanan      Int
  periode_mulai   DateTime @db.Date
  periode_selesai DateTime @db.Date

  layanan         Layanan  @relation(fields: [id_layanan],references: [id_layanan])
}